generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String   @map("password_hash")
  shareToken    String?  @unique @map("share_token")
  shareSettings Json?    @map("share_settings")
  createdAt     DateTime @default(now()) @map("created_at")

  jobs  Job[]
  tasks Task[]

  @@map("users")
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  companyName    String
  jobTitle       String
  status         String
  city           String?
  salaryRange    String?
  workMode       String?
  channel        String?
  priority       String?
  appliedDate    String?
  jobLink        String?
  jdText         String?
  contactName    String?
  contactInfo    String?
  nextAction     String?
  notes          String?
  endReason      String?
  interviewRounds Json?
  timeline        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  tasks Task[]

  @@index([userId])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  date      String?
  startTime String?
  endTime   String?
  priority  String?
  done      Boolean  @default(false)
  jobId     String?
  notes     String?

  user User @relation(fields: [userId], references: [id])
  job  Job?  @relation(fields: [jobId], references: [id])

  @@index([userId])
}
