# OfferFlow 环境变量配置
# 复制此文件为 .env 并填入你的配置

# 数据库（本地源码运行和 Docker 部署默认使用 SQLite）
DATABASE_URL="file:./dev.db"
# PostgreSQL 请将 DATABASE_URL 替换为连接地址，并取消下一行注释
# DIRECT_URL="postgresql://user:password@host/database"

# JWT 密钥（用于用户认证，请改为随机字符串）
JWT_SECRET=change-me-to-a-random-string

# 注册总开关；默认开放，设为 false 时完全关闭注册并忽略用户名白名单
REGISTER_ENABLED=true

# 仅在注册总开关开启时生效；留空允许任意用户名，多个用户名用英文逗号分隔
REGISTER_ALLOWED_USERNAMES=
